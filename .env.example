# --- Discovery (Google Shopping) ---
# Preferred: SerpAPI. Without it, /api/search may try a light HTML scrape, then mock.
SERPAPI_API_KEY=
# Alias accepted by the app:
# GOOGLE_SHOPPING_API_KEY=

# --- eBay Browse API (preferred over HTML when set) ---
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
# EBAY_ENV=PRODUCTION

# --- Amazon Product Advertising API 5.0 (optional; HTML scrape is fallback only) ---
AMAZON_ACCESS_KEY=
AMAZON_SECRET_KEY=
AMAZON_PARTNER_TAG=
# AMAZON_MARKETPLACE=www.amazon.com
# AMAZON_HOST=webservices.amazon.com
# AMAZON_REGION=us-east-1

# Optional UI hint only (not required for SerpAPI server path)
# NEXT_PUBLIC_GOOGLE_SHOPPING_API_KEY=

# --- Scrape policy ---
# No env enables cron. Scrapers run only on user-triggered /api/search, /api/discover, /api/price-check.
