# --- Discovery (Google Shopping) ---
# Preferred: SerpAPI. Without it, /api/search tries HTML scrape → Amazon → official PDPs.
SERPAPI_API_KEY=
# Alias accepted by the app:
# GOOGLE_SHOPPING_API_KEY=

# --- eBay Browse API (preferred over HTML when set) ---
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
# EBAY_ENV=PRODUCTION

# --- Amazon Product Advertising API 5.0 (optional; HTML scrape is fallback) ---
AMAZON_ACCESS_KEY=
AMAZON_SECRET_KEY=
AMAZON_PARTNER_TAG=
# AMAZON_MARKETPLACE follows active region (amazon.com.au / amazon.com)

# Optional UI hint only
# NEXT_PUBLIC_GOOGLE_SHOPPING_API_KEY=

# --- Scheduler ---
# SCHEDULER_SECRET=          # required header/query for /api/scheduler/run when set
# PRICE_CHECK_CRON=0 6 * * * # used by npm run scheduler
# SCHEDULER_BOOT_DELAY_MS=30000
# REGION=au                  # optional filter for npm run price-check:daily

# Default region is Australia (AUD). Switch in the UI (AU | US).
